# ===== AI Product Manager 环境变量 =====
# 复制此文件为 .env 并填入真实值

# --- 数据库 (Neon PostgreSQL, https://neon.tech 免费 0.5GB) ---
# 创建项目后复制连接字符串，格式: postgresql://user:pass@host/dbname?sslmode=require
DATABASE_URL="postgresql://USER:PASSWORD@EP-POOLING.us-east-2.aws.neon.tech/neondb?sslmode=require"

# --- LLM API Keys ---
# DeepSeek (开发调试用，便宜): https://platform.deepseek.com
DEEPSEEK_API_KEY="sk-xxx"

# Claude (面试 Demo 用，结构化输出更强): https://console.anthropic.com
ANTHROPIC_API_KEY="sk-ant-xxx"

# --- 搜索 (Tavily, https://app.tavily.com 免费 1000次/月) ---
TAVILY_API_KEY="tvly-xxx"
